SILICONFLOW_API_KEY=replace_me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MAP_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_JUDGE_MODEL=Qwen/Qwen3-VL-32B-Instruct
VH_ASR_MODEL=/data1/video-highlight-models/faster-whisper/models--Systran--faster-whisper-large-v3/snapshots/edaa852ec7e145841d8ffdb056a99866b5f0a478
VH_ASR_DEVICE=cuda:1
VH_MODEL_CACHE_DIR=/data1/video-highlight-models
HF_HUB_DISABLE_XET=1
VH_OCR_DEVICE=cpu
VH_OCR_VERSION=PP-OCRv6
VH_SENSEVOICE_MODEL=/data1/video-highlight-models/modelscope/models/iic--SenseVoiceSmall/snapshots/master
VH_SENSEVOICE_VAD_MODEL=/data1/video-highlight-models/modelscope/models/iic--speech_fsmn_vad_zh-cn-16k-common-pytorch/snapshots/master
VH_SENSEVOICE_DEVICE=cuda:2
VH_EMBEDDING_DEVICE=cuda:2
VH_EMBEDDING_MODEL=/data1/modelscope_models/Qwen3-VL-Embedding-2B
VH_JOB_OUTPUT_DIR=outputs/jobs
VH_MEDIA_CACHE_DIR=/data1/video-highlight-cache
VH_WRITE_TRACE=false
VH_WRITE_RESULT_FILE=true
VH_CANDIDATE_SEGMENT_SEC=90
VH_CANDIDATES_PER_SEGMENT=4
VH_MIN_LOCAL_CANDIDATES=6
VH_MAX_LOCAL_CANDIDATES=72
VH_MAX_JUDGE_CANDIDATES=18
VH_OCR_MAX_FRAMES=600
VH_WINDOW_SEC=20
VH_STRIDE_SEC=4
VH_CANDIDATE_NMS_IOU=0.60
VH_FINAL_NMS_IOU=0.40
VH_FINAL_THRESHOLD=0.65
VH_CONTEXT_BEFORE_SEC=30
VH_CONTEXT_AFTER_SEC=8
VH_MAP_WORKERS=3
VH_JUDGE_WORKERS=2

VH_MAX_HIGHLIGHTS=12

VH_REQUEST_MAX_RETRIES=2
