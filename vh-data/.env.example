VH_DATA_API_KEY=replace_me
VH_DATA_BASE_URL=https://api.fishkj.site/v1
VH_DATA_MODEL=gpt-6-astra
VH_DATA_REASONING_EFFORT=high
VH_DATA_ROOT=outputs/data
VH_DATA_MEDIA_CACHE=../vh-agent/outputs/data-media
VH_DATA_PAGE_SEC=30
VH_DATA_PREFERRED_HIGHLIGHT_SEC=15
VH_DATA_REQUEST_TIMEOUT_SEC=300
VH_DATA_REQUEST_ATTEMPTS=3
VH_DATA_WORKERS=2
VH_DATA_FRAME_FPS=1
VH_DATA_AGREEMENT_IOU=0.5

# 新视频对白转写；已有预处理记录会按源文件指纹复用
VH_DATA_PREPROCESS_CACHE=/data1/video-highlight-cache
VH_DATA_ASR_DEVICE=cpu
VH_DATA_ASR_COMPUTE_TYPE=int8
